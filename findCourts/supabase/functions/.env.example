# Server secrets only. Copy to .env.local for local functions serve --env-file.
# Configure production separately in Supabase Edge Function Secrets.
FIREBASE_PROJECT_ID=replace_with_firebase_project_id

CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
CLOUDINARY_UPLOAD_PRESET=replace_with_signed_preset_name

OVERPASS_ENABLED=false
OVERPASS_API_KEY=replace_with_overpass_ch_key
ADDRESS_ENRICHMENT_ENABLED=false
GEOAPIFY_API_KEY=replace_with_geoapify_key
